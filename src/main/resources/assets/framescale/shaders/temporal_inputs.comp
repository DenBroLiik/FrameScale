#version 450 core
// Camera-only reprojection for Photon TAAU. GL lower-left origin; +Y up.
// Motion is previous UV minus current UV, expressed in render-resolution pixels.
// validOut bit 0 = projection valid; bit 1 = hand depth (camera translation suppressed).
// This does not represent per-object animation, particles, transparency or LOD motion.
layout(local_size_x=8,local_size_y=8) in;
layout(binding=0) uniform sampler2D sceneColor;
layout(binding=1) uniform sampler2D sceneDepth;
layout(rgba16f,binding=0) writeonly uniform image2D hdrOut;
layout(r32f,binding=1) writeonly uniform image2D depthOut;
layout(rg16f,binding=2) writeonly uniform image2D motionOut;
layout(r8ui,binding=3) writeonly uniform uimage2D validOut;
uniform ivec2 sourceOrigin,renderExtent;
uniform mat4 currentToPreviousClip;
uniform mat4 currentToPreviousHandClip;
const float HAND_DEPTH=0.56;
bool finite4(vec4 v){return !any(isnan(v))&&!any(isinf(v));}
void main(){
    ivec2 p=ivec2(gl_GlobalInvocationID.xy);
    if(any(greaterThanEqual(p,renderExtent))||
       any(greaterThanEqual(p,imageSize(hdrOut)))||
       any(greaterThanEqual(p,imageSize(depthOut)))||
       any(greaterThanEqual(p,imageSize(motionOut)))||
       any(greaterThanEqual(p,imageSize(validOut)))) return;
    ivec2 s=sourceOrigin+p;
    vec3 rgb=vec3(0);float depth=1.;vec2 motion=vec2(0);uint valid=0u;
    if(all(greaterThanEqual(s,ivec2(0)))&&all(lessThan(s,textureSize(sceneColor,0)))&&
       all(lessThan(s,textureSize(sceneDepth,0)))){
        vec3 c=texelFetch(sceneColor,s,0).rgb;
        bool colorValid=finite4(vec4(c,1));
        if(colorValid) rgb=clamp(c,vec3(-65504),vec3(65504));
        float z=texelFetch(sceneDepth,s,0).r;
        if(colorValid&&!isnan(z)&&!isinf(z)&&z>=0.&&z<1.){
            depth=z;
            // Photon composite4 calls screen_to_view_space(..., false): its
            // projection matrices already define the coordinate convention here.
            vec2 currentNdc=((vec2(p)+.5)/vec2(renderExtent))*2.-1.;
            bool hand=z<HAND_DEPTH;
            mat4 reprojection=hand?currentToPreviousHandClip:currentToPreviousClip;
            vec4 previousClip=reprojection*vec4(currentNdc,z*2.-1.,1.);
            if(finite4(previousClip)&&previousClip.w>1e-6){
                vec3 previousNdc=previousClip.xyz/previousClip.w;
                vec2 previousUv=previousNdc.xy*.5+.5;
                vec2 deltaPixels=(previousNdc.xy-currentNdc)*.5*vec2(renderExtent);
                if(finite4(vec4(previousNdc,1))&&
                   all(greaterThanEqual(previousUv,vec2(0)))&&
                   all(lessThanEqual(previousUv,vec2(1)))&&
                   previousNdc.z>=-1.&&previousNdc.z<=1.&&
                   all(lessThanEqual(abs(deltaPixels),vec2(65504)))){
                    motion=deltaPixels;
                    valid=1u|(hand?2u:0u);
                }
            }
        }else if(!isnan(z)&&!isinf(z)&&z>=0.&&z<=1.){
            depth=z;
        }
    }
    imageStore(hdrOut,p,vec4(rgb,1));
    imageStore(depthOut,p,vec4(depth,0,0,0));
    imageStore(motionOut,p,vec4(motion,0,0));
    imageStore(validOut,p,uvec4(valid,0,0,0));
}
